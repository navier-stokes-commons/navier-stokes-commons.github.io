{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nsc:release-candidate:v2",
  "title": "Navier-Stokes Commons release candidate lineage record",
  "type": "object",
  "required": [
    "schema","candidate_id","parent_candidate_id","status","created_at_utc",
    "base_source_sha","product_digest_sha256","objective","material_changes",
    "known_unresolved","evidence_carried_forward","evidence_invalidated","supersession"
  ],
  "properties": {
    "schema": {"const":"nsc-release-candidate-v2"},
    "candidate_id": {"type":"string","pattern":"^RC-[0-9]{8}-[0-9]{3}$"},
    "parent_candidate_id": {"type":["string","null"]},
    "status": {"enum":["active","superseded","rejected","released"]},
    "created_at_utc": {"type":"string"},
    "base_source_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "product_digest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "objective": {"type":"string","minLength":20},
    "material_changes": {"type":"array","items":{"type":"string"}},
    "known_unresolved": {"type":"array","items":{"type":"string"}},
    "evidence_carried_forward": {"type":"array","items":{"type":"string"}},
    "evidence_invalidated": {"type":"array","items":{"type":"string"}},
    "supersession": {
      "type":"object",
      "required":["reason","trigger_evidence"],
      "properties": {
        "reason":{"type":["string","null"]},
        "trigger_evidence":{"type":"array","items":{"type":"string"}}
      }
    }
  },
  "additionalProperties": true
}
