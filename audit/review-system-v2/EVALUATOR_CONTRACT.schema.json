{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nsc-evaluator-contract-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","kind","role","mission","competence","epistemic_scope","blindness","observation_protocol","failure_sensitivities","evidence_requirements","adversarial_tasks","veto_conditions","output_contract","independence","calibration"],
  "properties": {
    "schema": {"const": "nsc-evaluator-contract-v2"},
    "id": {"type":"string","minLength":2},
    "kind": {"enum":["expert","synthetic-user-stratum","hostile-red-team","arbiter"]},
    "role": {"type":"string","minLength":8},
    "mission": {"type":"string","minLength":20},
    "competence": {
      "type":"object","additionalProperties":false,
      "required":["resume_floor","portfolio_evidence","methods","disqualifiers"],
      "properties": {
        "resume_floor":{"type":"array","minItems":2,"items":{"type":"string"}},
        "portfolio_evidence":{"type":"array","minItems":2,"items":{"type":"string"}},
        "methods":{"type":"array","minItems":2,"items":{"type":"string"}},
        "disqualifiers":{"type":"array","minItems":1,"items":{"type":"string"}}
      }
    },
    "epistemic_scope": {
      "type":"object","additionalProperties":false,
      "required":["may_establish","may_not_establish"],
      "properties": {
        "may_establish":{"type":"array","minItems":1,"items":{"type":"string"}},
        "may_not_establish":{"type":"array","minItems":1,"items":{"type":"string"}}
      }
    },
    "blindness": {
      "type":"object","additionalProperties":false,
      "required":["blind_to_prior_verdicts","blind_to_candidate_age","blind_to_author_rationale"],
      "properties": {
        "blind_to_prior_verdicts":{"type":"boolean"},
        "blind_to_candidate_age":{"type":"boolean"},
        "blind_to_author_rationale":{"type":"boolean"},
        "allowed_context":{"type":"array","items":{"type":"string"}}
      }
    },
    "observation_protocol": {"type":"array","minItems":3,"items":{"type":"string"}},
    "failure_sensitivities": {"type":"array","minItems":3,"items":{"type":"string"}},
    "evidence_requirements": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["criterion_id","modalities"],"properties":{"criterion_id":{"type":"string"},"modalities":{"type":"array","minItems":1,"items":{"type":"string"}},"notes":{"type":"string"}}}
    },
    "adversarial_tasks": {"type":"array","minItems":2,"items":{"type":"string"}},
    "veto_conditions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "output_contract": {
      "type":"object","additionalProperties":false,
      "required":["must_separate_observation_inference","must_cite_evidence_ids","must_report_unknowns","must_preserve_vetoes","forbidden_global_score"],
      "properties": {
        "must_separate_observation_inference":{"const":true},
        "must_cite_evidence_ids":{"const":true},
        "must_report_unknowns":{"const":true},
        "must_preserve_vetoes":{"const":true},
        "forbidden_global_score":{"const":true}
      }
    },
    "independence": {
      "type":"object","additionalProperties":false,"required":["group","rules"],
      "properties":{"group":{"type":"string","minLength":2},"rules":{"type":"array","minItems":1,"items":{"type":"string"}}}
    },
    "calibration": {
      "type":"object","additionalProperties":false,"required":["seeded_cases","minimum_recall","minimum_precision","required_before_pass_evidence"],
      "properties":{"seeded_cases":{"type":"integer","minimum":1},"minimum_recall":{"type":"number","minimum":0,"maximum":1},"minimum_precision":{"type":"number","minimum":0,"maximum":1},"required_before_pass_evidence":{"const":true}}
    }
  }
}
