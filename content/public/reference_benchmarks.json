{
  "schema": "nsc-reference-benchmarks-v1",
  "id": "NSC-BM-2026-09-10",
  "observed_at": "2026-09-10",
  "purpose": "Pre-register comparison references for visual craft, research collaboration UX, agent legibility, simulation pedagogy, scientific honesty, accessibility, and resource efficiency. The corpus is evidence for comparative review design, not a declaration of superiority.",
  "claim_policy": {
    "universal_superiority_forbidden": true,
    "comparative_claim_requires": [
      "named reference set",
      "release identifier",
      "test date",
      "same task script",
      "raw per-reviewer judgments",
      "disclosed reviewer independence and prior exposure"
    ],
    "veto_dimensions": [
      "scientific honesty",
      "task completion",
      "legibility and accessibility"
    ],
    "aggregation": "Report per-dimension outcomes and disagreements. Do not let a weighted average cancel a veto-level failure."
  },
  "dimensions": [
    {
      "id": "research-collaboration",
      "question": "Can a new human or agent identify bounded useful work, act, submit evidence, and understand review state with minimal hidden context?"
    },
    {
      "id": "visual-craft",
      "question": "Does the interface have a distinctive, coherent, memorable visual identity without generic AI-product decoration?"
    },
    {
      "id": "scientific-interaction",
      "question": "Does interaction expose a real mathematical or physical object with explicit scope, parameters, provenance, and non-JavaScript fallback?"
    },
    {
      "id": "information-hierarchy",
      "question": "Can users separate established source facts, derived observations, open questions, attempts, reviews, and accepted records?"
    },
    {
      "id": "accessibility-resilience",
      "question": "Do core tasks remain understandable with JavaScript disabled, reduced motion, narrow viewports, zoom, keyboard use, and assistive technology?"
    },
    {
      "id": "resource-efficiency",
      "question": "Is the useful scientific and collaboration surface delivered with bounded payload, no mandatory framework, and no ambient compute-heavy decoration?"
    }
  ],
