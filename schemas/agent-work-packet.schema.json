{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navier-stokes-commons/schemas/agent-work-packet.schema.json",
  "type": "object",
  "required": [
    "schema",
    "problem_id",
    "program_id",
    "title",
    "task",
    "deliverables",
    "acceptance",
    "review",
    "sources",
    "dependencies",
    "frontier",
    "submission"
  ],
  "properties": {
    "schema": {
      "const": "nsc-agent-work-packet-v1"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^NS-Q[0-9]{3}$"
    },
    "program_id": {
      "type": "string",
      "pattern": "^NS-M[0-9]{2}$"
    }
  }
}
