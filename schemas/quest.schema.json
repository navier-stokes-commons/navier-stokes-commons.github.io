{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSC Quest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mission_id",
    "status",
    "origin",
    "rung",
    "priority",
    "title",
    "summary",
    "task",
    "deliverables",
    "acceptance",
    "review",
    "contributors",
    "source_ids",
    "dependencies",
    "claim_ids",
    "tags",
    "parallel_safe",
    "non_exclusive"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NS-Q[0-9]{3}$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^NS-M[0-9]{2}$"
    },
    "status": {
      "enum": [
        "open",
        "in-review",
        "completed",
        "retired"
      ]
    },
    "origin": {
      "type": "string"
    },
    "rung": {
      "type": "string",
      "pattern": "^L[0-9]+$"
    },
    "priority": {
      "enum": [
        "launch",
        "standard",
        "later"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "summary": {
      "type": "string",
      "minLength": 12
    },
    "task": {
      "type": "string",
      "minLength": 12
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "class",
        "independence",
        "required_expertise"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "independence": {
          "type": "string"
        },
        "required_expertise": {
          "type": "string"
        }
      }
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NS-Q[0-9]{3}$"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NS-C[0-9]{3}$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parallel_safe": {
      "type": "boolean"
    },
    "non_exclusive": {
      "const": true
    },
    "benchmark_set_id": {
      "type": "string",
      "pattern": "^NSC-BM-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
