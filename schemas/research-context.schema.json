{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navier-stokes-commons.invalid/schemas/research-context.schema.json",
  "title": "Navier-Stokes Commons research context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "claim_status",
    "lineage",
    "affiliation_status",
    "concurrent_accounts",
    "commons_policy"
  ],
  "properties": {
    "schema": {
      "const": "nsc-research-context-v1"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "claim_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "scope",
        "unforced_boundary",
        "independent_review",
        "institutional_acceptance"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 20
        },
        "unforced_boundary": {
          "type": "string",
          "minLength": 10
        },
        "independent_review": {
          "enum": [
            "open",
            "partial",
            "independently-reviewed"
          ]
        },
        "institutional_acceptance": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "people",
          "title",
          "url",
          "note"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "people": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "concurrent_accounts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party",
          "title",
          "url",
          "summary"
        ],
        "properties": {
          "party": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "commons_policy": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "affiliation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "statement"
      ],
      "properties": {
        "independent": {
          "const": true
        },
        "statement": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  }
}
