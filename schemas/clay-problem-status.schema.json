{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navier-stokes-commons/schemas/clay-problem-status.schema.json",
  "type": "object",
  "required": [
    "schema",
    "observed_at",
    "official_problem",
    "alternatives",
    "landing_thesis"
  ],
  "properties": {
    "schema": {
      "const": "nsc-clay-problem-status-v2"
    },
    "alternatives": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "forcing",
          "target",
          "mathematical_status",
          "display_status",
          "openai_2026_claim"
        ]
      }
    }
  }
}
